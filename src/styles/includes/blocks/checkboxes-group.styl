.checkboxes-group
	&__title
		margin-bottom 1em
		font-weight 600
		font-size 16px
		line-height 1.625
		@extend .transition
		
		@media $xxs
			font-size 17px
		
		@media $smPlus
			color var(--black)
		
		&::after
			@extend .transition
		
		@media $xxs
			display grid
			grid-template-columns 1fr auto
			align-items center
			gap 15px
			
			&::after
				display none
	
	&__description
		padding 8px 30px 8px 13px
		border-radius 8px
		background #F5F7FC
		font-weight 600
		font-size 11px
		line-height 14px
		
		@media $smPlus
			margin 0
			padding 0
			border-radius 0
			background transparent
			color #666B80
			font-weight 400
			font-size 14px
			line-height 1.57143 
		
		@media $xxs
			font-size 13px
			line-height normal
	
	&__list
		list-style none
		display grid
		grid-template-columns 100%
		gap 16px
		@extend .transition
		
		@media (max-width: 991px)
			gap 14px
		
		@media $xxs
			gap 16px
			overflow auto
	
	&--row
		.checkboxes-group__title
			font-size 18px
			line-height 1.34
			color var(--black)

			@media $xs
				font-size 19px

			&:has(+.checkboxes-group__description)
				margin-bottom 0

				@media $xs
					margin-bottom 8px
		
		.checkboxes-group__description
			margin-bottom 1em
			
		.checkboxes-group__list
			display flex
			flex-wrap wrap
			gap 8px
		
		.checkboxes-group__item
			&:has(.checkbox--tag-style.checkbox--highlighted)
				order -1
	
	&--filter-element-popup
		.checkboxes-group__title
			margin-bottom 24px
			font-size 18px
			text-align center
			color var(--black)