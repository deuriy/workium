.media-upload-button
  display grid
  place-content center
  gap 2px
  width 100%
  height 84px
  padding 18px 0
  border none
  outline none
  border-radius 12px
  background #F0F4FA
  font-weight 500
  font-size 12px
  font-family var(--base-font)
  color #666B80
  cursor pointer

  &__text
    display none