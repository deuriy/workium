.rating-popup
  @media $smMinus
    max-height 100vh
    overflow auto
  
  &__body
    display grid
    grid-template-columns 1fr 320px
    gap 49px
    padding 24px 48px 20px

    @media $mdMinus
      gap 24px
      padding 24px 24px 20px
    
    @media $smMinus
      grid-template-columns 100%
    
    @media $xs
      gap 48px
      padding 12px 16px
  
  &__reviews
    position relative
    // max-height 658px
    padding-right 50px

    @media $md
      // max-height 630px
      max-height calc(100vh - 142px)
      // overflow auto
      overflow hidden

    @media $mdMinus
      padding-right 32px
    
    @media $smMinus
      padding-right 0
  
  &__rating-criteria
    @media $smMinus
      order -1