.rating-criteria
  &__title
    margin-bottom 16px
    font-weight 600
    font-size 20px
    line-height 1.3
    color #000
  
  &__rating
    margin-bottom 16px

    @media $xs
      margin-bottom 10px
    
  &__item
    & + &
      margin-top 20px

      @media $xs
        margin-top 16px
  
  &__notice
    margin-top 90px

    @media $mdMinus
      margin-top 70px
  
  &--dropdown
    .rating-criteria__item + .rating-criteria__item
      margin-top 12px
    
    .rating-criteria__criterion
      font-size 13px
      line-height 1.69230769
      