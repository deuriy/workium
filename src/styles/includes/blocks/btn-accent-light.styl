.btn-accent-light
	display inline-flex
	justify-content center
	align-items center
	gap 3px
	padding 11px 24px
	border none
	outline none
	border-radius 12px
	font-weight 500
	font-size 16px
	line-height 1.625
	font-family var(--base-font)
	background var(--accent-light)
	color var(--light)
	white-space nowrap
	cursor pointer
	text-decoration none
	@extend .transition