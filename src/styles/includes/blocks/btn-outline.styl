.btn-outline
  display inline-flex
  justify-content center
  align-items center
  gap 3px
  padding 10px 12px
  border 1px solid var(--info)
  outline none
  border-radius 12px
  font-weight 500
  font-size 16px
  line-height 1.625
  font-family var(--base-font)
  background transparent
  color var(--info)
  white-space nowrap
  cursor pointer
  text-decoration none
  @extend .transition
  
  @media $smPlus
    padding 10px 26px
  
  &:hover
    background var(--info)
    color var(--light)
  
  &--promo-blocks,
  &--banner
    text-align center
    
    @media $smPlus
      padding 10px 26px
    
    @media $xs
      line-height 18px
  
  &--banner
    @media $xs
      line-height 1.625
  
  &--vacancies-title
    // padding 8px 21px
    // font-weight 400
    // font-size 13px
    
    padding 8px 21px
    border-width 2px
    font-size 14px
    
    @media $xs
      padding 5px 10px
      border-radius 8px
      
      // border-radius 6px
      // font-weight 500
      // font-size 12px