.btn-outline
  display inline-flex
  justify-content center
  align-items center
  gap 3px
  padding 10px 12px
  border 1px solid var(--info)
  outline none
  border-radius 12px
  font-weight 500
  font-size 16px
  line-height 1.625
  font-family var(--base-font)
  background transparent
  color var(--info)
  white-space nowrap
  cursor pointer
  text-decoration none
  @extend .transition
  
  @media $smPlus
    padding 10px 26px
  
  &:hover
    background var(--info)
    color var(--light)