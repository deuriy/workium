.audio-volume
  display flex
  align-items center
  border-radius 8px
  background #fff

  &__range
    --fill-percent 100%
    position relative
    z-index 1
    margin-right -20px
    width 0
    height 16px
    overflow hidden
    transition .4s
    appearance none
    background transparent

    &::-webkit-slider-runnable-track
      height 4px
      background linear-gradient(
            to right,
            #5b4bff 0%,
            #5b4bff var(--fill-percent),
            #E5E8FF var(--fill-percent),
            #E5E8FF 100%
        )
      border-radius 6px

    &::-moz-range-track
      height 4px
      background #E5E8FF
      border-radius 6px
      cursor pointer
    
    &::-moz-range-progress
      background var(--info)
    
    &::-webkit-slider-thumb
      appearance none
      width 16px
      height 16px
      background var(--info)
      border 2px solid #fff
      border-radius 50%
      margin-top -6px
      cursor pointer
    
    &::-moz-range-thumb
      width 16px
      height 16px
      background var(--info)
      border 2px solid #fff
      border-radius 50%
      cursor pointer

  &__btn
    width 40px
    height 24px
    border none
    outline none
    border-radius 8px
