.label
  display inline-flex
  justify-content center
  align-items center
  padding 0 8px
  border-radius 4px
  background #F0F4FA
  color #666B80
  font-size 13px
  line-height 1.692
  text-align center
  
  &--promo-block
    position relative
    text-decoration none
  
  &--pink-bg
    background #F3D9D9
  
  &--vacancy-block
    padding 5px 12px
    border-radius 8px
    font-weight 500
    background #F4F5FC
    color #0F182A 