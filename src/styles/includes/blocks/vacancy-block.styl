.vacancy-block
  position relative
  display grid
  grid-template-columns 100%
  grid-template-rows repeat(4, auto) 1fr
  padding 24px
  border 1px solid #DFE1ED
  border-radius 16px
  @extend .transition
  
  @media $xs
    padding 20px
  
  @media $xxs
    padding 16px
  
  &:hover
    border-color #2A364D
  
  &__title,
  &__salary-per-month
    font-size 20px
    line-height 1.3
    
    @media $xxs
      font-size 18px
  
  &__title
    display -webkit-box
    -webkit-line-clamp 2
    -webkit-box-orient vertical
    overflow hidden
    text-overflow ellipsis
    margin-bottom 12px
    font-weight 600
    
    @media $xxs
      margin-bottom 8px
  
  &__salary-per-hour
    margin-bottom 12px
    font-size 13px
    line-height 1.53846
  
  &__label
    justify-self start
    margin-bottom 12px
    
    @media $xxs
      margin-bottom 8px
  
  &__bottom
    display grid
    grid-template-columns repeat(2, auto)
    justify-content space-between
    align-items start
    gap 12px
    margin-top auto
  
  &--vacancies-page-style
    @media $xs
      .vacancy-block__title,
      .vacancy-block__salary-per-month
        font-weight 700
        font-size 21px
      
      .vacancy-block__salary-per-hour
        font-weight 700
        font-size 16px
      
      .vacancy-block__label
        // padding 5px 12px
        padding 2px 6px
        border-radius 8px
        // font-weight 500
        font-weight 600
        font-size 17px
        background #D4F6DA
        // background #F4F5FC
        color #0F182A 
  
  &--vacancies-page-style2
    @media $xs
      .vacancy-block__title,
      .vacancy-block__salary-per-month
        font-weight 700
        font-size 19px
      
      .vacancy-block__title
        font-size 18px
      
      .vacancy-block__salary-per-hour
        margin-bottom 8px
        font-weight 700
        font-size 14px
      
      .vacancy-block__label
        margin-bottom 4px
        font-size 15px
      
    