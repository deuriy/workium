.filter-element
	@media $xxs
		// padding 22px 16px
		padding 0 16px 30px
		
	&__title
		font-weight 600
		font-size 18px
		line-height 1.34
		color #0f182a

		&:not(:has(+ .filter-element__description))
			margin-bottom 1em
		
		@media $xxs
			font-size 17px
	
	&__header
		margin-bottom 28px

		.filter-element__title
			margin-bottom 0
		
		&--two-col
			display grid
			grid-template-columns repeat(2, auto)
			justify-content space-between
			align-items center
			gap 20px
	
	&__description
		margin-bottom 1em
		font-size 14px
		font-weight 400
		line-height 1.57143
		color #666B80
	
