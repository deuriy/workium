.employment-variant
  display grid
  grid-template-columns 100%
  padding 8px 16px
  border 1px solid #DFE1ED
  border-radius 8px
  color var(--accent)
  text-decoration none
  
  @media $xs
    // width 370px
    width 200px
    max-width 100%
  
  &__title
    margin-bottom 5px
    font-weight 600
    font-size 12px
    line-height 1.67
    text-transform uppercase
    color #989DB3
  
  &__salary
    font-weight 600
    font-size 12px
  
  &__label
    display inline-grid
    margin 10px auto -20px
    padding 3px 21px
    border-radius 8px
    background #020202
    color var(--light)
    font-size 10px
    
    // @media $xs
    //   margin-top 8px
    //   margin-right 0
  
  &:is(a):hover,
  &--selected
    padding 6px 14px
    border 3px solid #020202
    border-radius 12px