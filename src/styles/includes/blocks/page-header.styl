		// text-align center
		
		// @media $1440-
		// 	padding 40px 20px
		
		// @media $mdMinus
		// 	padding 25px 15px
	
	&__title
		margin-bottom 16px
		font-weight 600
		// font-size 20px
		font-size 24px
		line-height normal
		
