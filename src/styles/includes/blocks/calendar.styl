/* =========================================
   MONTH BLOCK
========================================= */

.js-body {
    max-height: calc(100% - 152px);
    // max-height: calc(100% - 182px);
    overflow: auto;
    scrollbar-width none
}
.js-body::-webkit-scrollbar {
    display none
}

.calendar .month {
    margin-bottom: 32px;
}

.calendar .month h4 {
    font-size: 18px;
    line-height: 1.33;
    margin-bottom: 8px;
    font-weight: 600;
    color #000
}

/* =========================================
   DAYS GRID
========================================= */

.calendar .days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    justify-items center
    gap: 8px 36px;
}

.calendar .days button {
    border none
    background transparent
}

.calendar .days button span {
    display flex
    align-items center
    justify-content center
    width 48px
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    font-weight: 500;
    font-size: 16px;
    font-family: var(--base-font);
    color #000
    // transition: all .15s ease;
    position: relative;
}

.calendar .days button span:hover {
    background: #F4F5FC;
}

/* Selected day */
.calendar .days button.selected span {
    z-index 2
    background: #5340FF;
    color: #fff;
}
