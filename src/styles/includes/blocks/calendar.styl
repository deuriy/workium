/* Range background */
.calendar .days button {
    position relative
}
.calendar .days button.range {
    background: #F4F5FC;
    border-radius: 0;
}
.calendar .days button.range:nth-child(7n) span {
    border-top-right-radius 12px
    border-bottom-right-radius 12px
}
.calendar .days button.range:nth-child(7n+1) span,
.calendar .days button.range:nth-of-type(1) span {
    border-top-left-radius 12px
    border-bottom-left-radius 12px
}
.calendar .days button::after {
    content: "";
    position absolute;
    top 0
    right -48px
    width: 48px;
    height: 48px;
    background: transparent;
    pointer-events none
}
.calendar .days button.range::after {
    background: #F4F5FC;
}

.calendar .days button.selected:has(+button.selected)
    z-index 2

.calendar .days button.selected + button.selected::before,
.calendar .days button.selected:has(+button.selected)::after,
.calendar .days button.selected + button:not(.selected):hover::before
    background #F4F5FC

.calendar .days button.selected + button:not(.selected):hover::before
    width 70px

.calendar .days button.selected + button.selected + button:not(.selected):hover::before
    background transparent

// .calendar .days button.selected + button.selected::before {
//     content: "";
//     position absolute;
//     top 0
//     right 48px
//     width: 48px;
//     height: 48px;
//     background: #F4F5FC;
//     pointer-events none
// }

.calendar .days button.range:nth-child(7n)::after,
.calendar .days button.range:nth-of-type(1)::before,
.calendar .days button.range:last-child::after,
.calendar .days button.range:nth-child(7n+1)::before {
    display none
}
.calendar .days button::before {
    content ""
    position absolute
    z-index -1
    top 0
    left -48px
    width 48px
    height 48px
    background: transparent;
    pointer-events none
}
.calendar .days button.range::before {
    background: #F4F5FC;
}

/* Correct rounding for range edges */
.calendar .days button.range:first-child {
    border-radius: 20px 0 0 20px;
}

.calendar .days button.range:last-child {
    border-radius: 0 20px 20px 0;
}
.calendar .days button.range:last-child::after {
    content: '';
    position: absolute;
    width: 36px;
    height: 48px;
}

/* =========================================
   FOOTER
========================================= */

.calendar .calendar-footer {
    display flex
    align-items center
    justify-content space-between
    gap 12px
    margin 0 -24px
    padding 16px 24px 0
    box-shadow: 0px -4px 10px rgba(0, 0, 0, 0.1);
}

.calendar .accuracy {
    display: flex;
    gap: 8px;
    overflow auto
    scrollbar-width none
    
    // flex-wrap: wrap;
    // margin-bottom: 18px;
}

.calendar .accuracy::-webkit-scrollbar {
    display none
}

.calendar .accuracy button {
    // padding: 11px 15px;
    flex-shrink 0
    padding: 11px 12px;
    border-radius: 90px;
    border: 1px solid #DFE2E6;
    background: #fff;
    cursor: pointer;
    font-weight 500
    font-size: 14px;
    line-height 1.57142857
    font-family var(--base-font)
    color #000
    // transition: .2s;
}

.calendar .accuracy button:hover,
.calendar .accuracy button.active {
    // padding: 10px 14px;
    padding: 10px 11px;
    border: 2px solid #0F182A;
    background: #F4F5FC;
}

/* =========================================
   ACTIONS
========================================= */

.calendar .footer-actions {
    display: grid;
    grid-template-columns 100%
    align-items: center;
    justify-content: space-between;
    gap 16px
}

.calendar:has(.calendar-clear.is-visible) .js-body {
    max-height calc(100% - 216px)
}
.calendar:has(.calendar-clear.is-visible) .calendar-footer {
    display block
}
.calendar:has(.calendar-clear.is-visible) .footer-actions {
    grid-template-columns auto 169px
    margin-top 16px
}

.calendar .js-clear {
    background: none;
    border: none;
    color: #5340FF;
    font-weight: 600;
    font-size 16px
    line-height 1.625
    font-family var(--base-font)
    cursor: pointer;
}

