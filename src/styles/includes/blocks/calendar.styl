/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 767px) {
    .calendar {
        .calendar-overlay {
            padding 0
        }

        .calendar-modal {
            width 100%
        }
    }
}

@media (max-width: 575px) {
    .calendar .calendar-field {
        width 100%
    }

    .calendar .calendar-modal {
        // width: 95%;
        // padding: 20px;
        // border-radius: 18px;
        
        width 100%
        padding 12px 16px
        border-radius 0
    }

    .js-body {
        max-height calc(100% - 216px)
    }

    .calendar .global-weekdays,
    .calendar .days {
        gap 8px
    }

    .calendar .global-weekdays {
        margin-bottom 8px
        padding-bottom 8px
    }

    .calendar .month {
        margin-bottom: 24px;
    }

    .month + .month {
        padding-top: 24px;
    }

    .calendar .month h4 {
        margin-bottom 16px
    }

    .calendar .days button span {
        width 40px
        height 40px
        // height: 36px;
        // font-size: 13px;
    }

    .calendar .days button.range::before,
    .calendar .days button.range::after {
        height 40px
    }

    .calendar .calendar-footer {
        display block
        padding 12px 16px 0
    }

    .calendar .accuracy {
        margin 0 -12px
        padding 0 12px
    }

    .calendar .accuracy button {
        padding 11px 16px
    }

    .calendar .accuracy button:hover,
    .calendar .accuracy button.active {
        padding 10px 15px
    }

    .calendar .footer-actions {
        margin-top 16px
    }

    .calendar-modal__apply-btn {
        width 100%;
    }

    .calendar:has(.calendar-clear.is-visible) .calendar-modal__apply-btn {
        width auto
    }

}

@media (min-width: 576px) {
    .calendar .global-weekdays {
        grid-template-columns: repeat(7, 48px);
        justify-content center
        gap 20px
        font-size: 13px;
    }

    .calendar .month h4 {
        text-align center
    }

    .calendar .days {
        grid-template-columns: repeat(7, 48px);
        justify-content center
        gap: 8px 20px;
    }

    // .calendar .days button {
    //     width auto
    // }
}
