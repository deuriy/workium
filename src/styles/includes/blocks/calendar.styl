.calendar .js-title {
    font-size: 16px;
    line-height: 1.625;
    font-weight: 600;
    color: #000;
}

/* =========================================
   WEEKDAYS
========================================= */

.calendar .global-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 36px;
    margin-bottom: 12px;
    padding-bottom 12px
    font-size: 12px;
    line-height: 1.67;
    color: #000;
    text-align: center;
    font-weight: 800;
    text-transform uppercase
}

.calendar .month {
    margin-bottom: 32px;
}

.month + .month {
    padding-top: 32px;
    border-top: 1px solid #EBEBEB;
}


