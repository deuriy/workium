.form-label
	display block
	font-size 16px
	line-height 1.625
	color var(--dark)
	cursor pointer
	
	&--authorization-form
		font-weight 600
		font-size 14px
		line-height 1.7143
	
	&--add-review
		font-weight 600
		font-size 15px
		line-height 1.6
		color var(--accent)

	&--inline-flex
		display inline-flex
	
	&--exclamation-mark
		gap 6px
		align-items center

		&::after
			content ''
			width 16px
			height 16px
