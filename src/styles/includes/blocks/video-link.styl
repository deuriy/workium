.video-link
  display inline-grid
  grid-template-columns auto auto
  justify-content start
  gap 8px
  align-items center
  color var(--info)
  font-weight 500
  font-size 16px
  line-height 1.625
  text-decoration none
  
  &::before
    content ""
    width 18px
    height 18px
    border-radius 50%
