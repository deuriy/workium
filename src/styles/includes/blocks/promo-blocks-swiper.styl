.promo-blocks-swiper
	padding-top 24px
	padding-bottom 24px
	
	@media $xs
		padding-right 16px
		padding-left 16px
	
	&__slides
		align-items end
	
	&__slide
		width auto
		
		&--active
			.promo-blocks-swiper__variant-label
				color var(--black)
	
	&__pagination
		margin-top 17px
	
	&__variant-label
		position absolute
		z-index 1
		// top -32px
		top -37px
		right 0
		font-size 14px
		// color #666B80
		color #555a6d

		@media $smPlus
			// top -27px
			top -33px
			right 2px
			font-size 13px
	
	&__company
		position absolute
		z-index 1
		// top -34px
		top -38px
		right 0
		display grid
		grid-template-columns 24px 1fr
		gap 8px
		align-items center
	
	&__company-name
		font-weight 700
		font-size 13px
	
	&__prev-btn,
	&__next-btn
		position absolute
		z-index 10
		top 28px
		bottom 50px
		width 32px
		margin auto
		border none
		outline none
		background var(--light)
		cursor pointer
		@extend .transition

		&::after
			content ''
			position absolute
			top 0
			bottom 0
			background #fff
			filter blur(20px)
		
		svg
			position relative
			z-index 1

			path
				@extend .transition
		
		&:hover
			svg
				path
					fill var(--accent)
		
		&.swiper-btn--disabled
			opacity 0
			visibility hidden
	
	&__prev-btn
		left 0

		&::after
			right -38px
			left -8px
	
	&__next-btn
		right 0

		&::after
			right -18px
			left -40px
	
	&--working-conditions
		@media $xs
			margin-top -42px
			// padding-top 45px
			// padding-top 50px
			padding-top 54px
			// padding-top 3px
			padding-bottom 3px
			
			.promo-blocks-swiper__slides
				align-items stretch
				height auto
			
			.promo-blocks-swiper__slide
				height auto
			
			.promo-blocks-swiper__item
				height 100%
	
	&--working-conditions-full-vacancy
		@media $smPlus
			padding 30px 24px
	
	&--working-conditions-single-item
		@media $xs
			// padding-top 24px
				
			// padding-top 54px
			
			padding-top 20px
			padding-bottom 24px