.people-section
	&__title
		margin-bottom 12px
	
	&__text
		margin-bottom 48px
		
		@media $xs
			margin-bottom 24px
	
	&__swiper-container
		@media $xs
			margin-right -16px
			margin-left -16px
	
	&__bottom
		margin-top 48px
		text-align center
	
	&__btns
		display flex
		flex-wrap wrap
		justify-content center
		gap 12px
		margin-top 23px
		
		@media $xxs
			flex-direction column
			gap 10px
			margin-top 12px
	
	&__btn
		@media $xxs
			flex-grow 1
			flex-basis 0