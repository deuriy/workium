.accordion
  padding 32px 32px 0
  border-radius 12px
  background var(--light)
  
  @media $smMinus
    padding 24px 24px 0
    border-radius 10px
  
  @media $xs
    padding 20px 20px 0
    border-radius 8px
  
  &__title
    margin-bottom 24px
    font-weight 600
    font-size 24px
    line-height 1.5
    
    @media $smMinus
      margin-bottom 16px
  
  &__item
    border-top 1px solid #DFE2E6