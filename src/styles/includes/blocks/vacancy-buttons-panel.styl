.vacancy-buttons-panel
  display flex
  // flex-wrap wrap
  gap 12px
  padding 16px
  background #FFFFFF
  box-shadow 0px 4px 24px rgba(0, 0, 0, 0.15)
  border-radius 12px
  
  &__btn,
  &__bookmark-icon,
  &__copy-btn
    flex-shrink 0
  
  &__btn
    &:first-child
      flex-shrink 1
    
    &.btn-default--promo-blocks
      @media $smPlus
        padding 15px 12px
  
  &__bookmark-icon
    align-self center
    margin-left 12px