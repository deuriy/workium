.not-found
  text-align center

  &__lottie
    margin-bottom 10px

  &__lottie-player
    width 110px
    margin auto

  &__title
    margin-bottom 10px
    font-weight 600
    font-size 18px
    line-height 1.34
    color var(--black)
  
  &__text
    margin-bottom 20px
    font-size 14px
    line-height 1.57143
    color var(--black)
  
  &__link
    font-weight 600
    font-size 16px
    color var(--info)
    text-decoration none