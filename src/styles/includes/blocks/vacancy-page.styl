.vacancy-page
	@media $xs
		padding-bottom 50px
		
	&__breadcrumbs
		margin -2px 0 14px -1px
		
		@media $md
			margin -5px 0 23px 3px
		
	&__title
		margin-bottom 32px
	
	&__vacancy-card
		margin-bottom 15px
		
		@media $xs
			margin-right -16px
			margin-left -16px
	
	&__infoblock
		& + .vacancy-page__infoblock
			margin-top 16px
	
	&--business-pricing
		.vacancy-page__title
			@media $smPlus
				margin-bottom 20px
				padding 25px 35px
				box-shadow 0px 4px 24px rgba(0, 0, 0, 0.15)
				border-radius 12px
				background #FFF