.btn-grey-light
  display inline-grid
  justify-content center
  align-items center
  padding 11px 12px
  border none
  outline none
  border-radius 8px
  font-weight 500
  font-size 15px
  line-height 1.6
  font-family var(--base-font)
  background var(--grey-light)
  color var(--accent)
  white-space nowrap
  cursor pointer
  text-decoration none
  @extend .transition
  
  &:hover
    background #E8E8E8